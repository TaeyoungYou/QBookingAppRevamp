{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },

  "paths": {
    "@convex-dev/auth/providers/*": [
    "./node_modules/@convex-dev/auth/dist/providers/*/index.d.ts"
    ]
  },
  "include": [
    "convex/**/*.ts",
    "node_modules/@convex-dev/auth/**/*.d.ts",
    "src"
  ]
}
